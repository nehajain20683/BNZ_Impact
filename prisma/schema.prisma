// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is only needed if DATABASE_URL uses pgbouncer=true
  // For Supabase Transaction Pooler (port 6543), directUrl is NOT needed
  // directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  mobile         String?
  address        String?
  pan            String?
  password       String?
  role           Role      @default(DONOR)
  image          String?
  // Extended fields
  isActive       Boolean   @default(true)
  isLocked       Boolean   @default(false)
  lastLoginAt    DateTime?
  loginAttempts  Int       @default(0)
  // Password reset
  resetOtpHash   String?
  resetOtpExpiry DateTime?
  // Soft delete
  deletedAt      DateTime?
  deletedById    String?
  deleteReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donations  Donation[]
  accounts   Account[]
  sessions   Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  treePrice   Float    @default(500)
  active      Boolean  @default(true)
  imageUrl    String?
  goal        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations Donation[]

  @@map("campaigns")
}

model Donation {
  id               String          @id @default(cuid())
  userId           String?
  campaignId       String
  amount           Float
  numberOfTrees    Int
  donorName        String
  certificateName  String?         // name to appear on certificate (can differ from donor)
  donorEmail       String
  donorMobile      String?
  donorAddress     String?
  donorPan         String?
  donorChapter     String?
  dedicationName   String?
  dedicationType   DedicationType?
  paymentStatus    PaymentStatus   @default(PENDING)
  paymentGatewayId String?
  paymentOrderId   String?
  paymentMethod    String?
  receiptNumber    String?         @unique
  certificateUrl   String?
  receiptUrl       String?
  // Manual entry fields
  paymentMode      String?         @default("ONLINE") // ONLINE | CASH | BANK_TRANSFER | CHEQUE | UPI
  paymentBank      String?         // for BANK_TRANSFER (e.g. Bank of Ghatkopar)
  paymentBranch    String?         // branch name
  chequeNumber     String?
  waMessageSent    Boolean         @default(false)
  waMessageSentAt  DateTime?
  certificateSent  Boolean         @default(false)
  certificateSentAt DateTime?
  form80GSent      Boolean         @default(false)
  notes            String?
  refId            String?         @unique // auto-generated ref like #JITO-00001
  createdById      String?         // admin who manually added
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user        User?       @relation(fields: [userId], references: [id])
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  trees       Tree[]
  receipt     Receipt?
  certificate Certificate?

  @@map("donations")
}

model Tree {
  id          String     @id @default(cuid())
  donationId  String
  treeTagId   String?    @unique
  species     String?
  geoLatitude Float?
  geoLongitude Float?
  plantedDate DateTime?
  imageUrl    String?
  status      TreeStatus @default(PENDING)
  expectedCO2 Float?
  siteId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  donation       Donation        @relation(fields: [donationId], references: [id])
  plantationSite PlantationSite? @relation(fields: [siteId], references: [id])

  @@map("trees")
}

// ─── MASTER PROJECT ──────────────────────────────────────────────────────────
model MasterProject {
  id          String   @id @default(cuid())
  name        String                          // "JITO Green Legacy"
  code        String?  @unique
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites PlantationSite[]

  @@map("master_projects")
}

// ─── PLANTATION SITE (enhanced) ──────────────────────────────────────────────
model PlantationSite {
  id                String   @id @default(cuid())
  projectId         String?
  project           MasterProject? @relation(fields: [projectId], references: [id])
  // Identity
  siteName          String
  siteCode          String?  @unique
  internalRef       String?
  description       String?
  // Location
  state             String?
  district          String?
  taluka            String?
  village           String?
  gpsLatitude       Float?
  gpsLongitude      Float?
  geoData           Json?    // GeoJSON polygon
  // Area
  totalPlannedArea  Float?   // acres
  // Phase
  currentPhase      String   @default("PLANNING")
  // Team
  plantationPartner String?
  implementingAgency String?
  fieldOfficerId    String?
  supervisorId      String?
  carbonConsultant  String?
  auditor           String?
  nursery           String?
  // Dates
  plantationSeason  String?
  startDate         DateTime?
  endDate           DateTime?
  // Targets
  totalFarmers      Int?
  plannedArea       Float?
  plannedTrees      Int?
  estimatedCarbon   Float?
  estimatedCredits  Float?
  expectedSurvival  Float?
  budget            Float?
  // Actuals
  treesPlanted      Int      @default(0)
  treesSurviving    Int      @default(0)
  survivalRate      Float?
  // Status
  active            Boolean  @default(true)
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trees             Tree[]
  landAssignments   LandAssignment[]
  activities        PlantationActivity[]
  monitoringVisits  MonitoringVisit[]
  carbonMonitoring  CarbonMonitoring[]
  siteDocuments     SiteDocument[]
  timelineEvents    TimelineEvent[]
  speciesPlans      SpeciesPlan[]
  notifications     SiteNotification[]

  @@map("plantation_sites")
}

// ─── SPECIES PLAN ─────────────────────────────────────────────────────────────
model SpeciesPlan {
  id              String   @id @default(cuid())
  siteId          String
  site            PlantationSite @relation(fields: [siteId], references: [id])
  species         String
  plannedQty      Int
  nurserySource   String?
  expectedSurvival Float?
  carbonFactor    Float?
  remarks         String?
  createdAt       DateTime @default(now())

  @@map("species_plans")
}

// ─── LAND ASSIGNMENT (Farmer Land → Plantation Site) ─────────────────────────
model LandAssignment {
  id              String   @id @default(cuid())
  siteId          String
  site            PlantationSite @relation(fields: [siteId], references: [id])
  farmerId        String
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  landId          String?
  land            Land?    @relation(fields: [landId], references: [id])
  // Assignment details
  treesAssigned   Int
  speciesAlloc    Json?    // [{species, qty}]
  plantationDate  DateTime?
  remarks         String?
  // Lifecycle stage
  stage           String   @default("ASSIGNED")
  // Actuals
  treesPlanted    Int      @default(0)
  treesSurviving  Int      @default(0)
  lastMonitored   DateTime?
  speciesPlanted  Json?    // [{species, qty, date}] cumulative
  driveLinks      String[] // Google Drive photo links
  // Flags
  consentSigned   Boolean  @default(false)
  consentDate     DateTime?
  assignedById    String?
  assignedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stageHistory    LandStageHistory[]
  monitoring      MonitoringVisit[]

  @@unique([siteId, landId])
  @@map("land_assignments")
}

// ─── LAND STAGE HISTORY ───────────────────────────────────────────────────────
model LandStageHistory {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   LandAssignment @relation(fields: [assignmentId], references: [id])
  stage        String
  date         DateTime @default(now())
  updatedById  String?
  photos       String[]
  remarks      String?

  @@map("land_stage_history")
}

// ─── PLANTATION ACTIVITY ──────────────────────────────────────────────────────
model PlantationActivity {
  id           String   @id @default(cuid())
  siteId       String
  site         PlantationSite @relation(fields: [siteId], references: [id])
  date         DateTime
  activityType String   // PIT_DIGGING | SAPLING_DELIVERY | PLANTATION | IRRIGATION | FERTILIZER | WEEDING | GAP_FILLING | MONITORING | SURVIVAL_SURVEY
  description  String?
  team         String?
  workers      Int?
  treesPlanted   Int?
  speciesPlanted Json?    // [{species, qty}]
  driveLink      String?  // Google Drive / Photos link
  photos         String[]
  documents      String[]
  remarks        String?
  loggedById     String?
  createdAt      DateTime @default(now())

  @@map("plantation_activities")
}

// ─── MONITORING VISIT ─────────────────────────────────────────────────────────
model MonitoringVisit {
  id             String   @id @default(cuid())
  siteId         String
  site           PlantationSite @relation(fields: [siteId], references: [id])
  assignmentId   String?
  assignment     LandAssignment? @relation(fields: [assignmentId], references: [id])
  visitDate      DateTime
  officerId      String?
  farmerId       String?
  survivalCount  Int?
  deadTrees      Int?
  diseaseNotes   String?
  avgHeight      Float?   // cm
  photos         String[]
  gpsLat         Float?
  gpsLng         Float?
  recommendations String?
  survivalPct    Float?
  mortalityPct   Float?
  createdAt      DateTime @default(now())

  @@map("monitoring_visits")
}

// ─── CARBON MONITORING ────────────────────────────────────────────────────────
model CarbonMonitoring {
  id              String   @id @default(cuid())
  siteId          String
  site            PlantationSite @relation(fields: [siteId], references: [id])
  methodology     String?  // Verra VM0047 | Gold Standard | etc.
  creditingPeriod Int?     // years
  vintage         String?
  monitoringPeriod String?
  baseline        Float?
  additionality   Float?
  leakage         Float?
  bufferPool      Float?
  registryStatus  String   @default("DRAFT")
  registryLink    String?
  totalCredits    Float?
  issuedCredits   Float?
  pendingCredits  Float?
  notes           String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("carbon_monitoring")
}

// ─── TIMELINE EVENT ───────────────────────────────────────────────────────────
model TimelineEvent {
  id          String   @id @default(cuid())
  siteId      String
  site        PlantationSite @relation(fields: [siteId], references: [id])
  eventType   String
  title       String
  description String?
  eventDate   DateTime @default(now())
  attachments String[]
  createdById String?
  createdAt   DateTime @default(now())

  @@map("timeline_events")
}

// ─── SITE DOCUMENT ────────────────────────────────────────────────────────────
model SiteDocument {
  id          String   @id @default(cuid())
  siteId      String
  site        PlantationSite @relation(fields: [siteId], references: [id])
  folder      String   // PLANTATION_PLAN | FARMER_CONSENTS | GPS_MAPS | etc.
  fileName    String
  fileUrl     String
  fileSize    Int?
  version     Int      @default(1)
  uploadedById String?
  uploadedAt  DateTime @default(now())

  @@map("site_documents")
}

// ─── SITE NOTIFICATION ────────────────────────────────────────────────────────
model SiteNotification {
  id        String   @id @default(cuid())
  siteId    String
  site      PlantationSite @relation(fields: [siteId], references: [id])
  type      String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("site_notifications")
}

model Receipt {
  id            String   @id @default(cuid())
  donationId    String   @unique
  receiptPdfUrl String?
  generatedAt   DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id])

  @@map("receipts")
}

model Certificate {
  id                String   @id @default(cuid())
  donationId        String   @unique
  certificatePdfUrl String?
  generatedAt       DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id])

  @@map("certificates")
}

enum Role {
  DONOR
  ADMIN
  SUPER_ADMIN
  FIELD_OFFICER
  DATA_ENTRY
  PROJECT_MANAGER
  AUDITOR
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DedicationType {
  MOTHER
  FATHER
  GRANDPARENTS
  DAUGHTER
  MEMORIAL
  CSR
  OTHER
}

enum TreeStatus {
  PENDING
  PLANTED
  GROWING
  MATURE
}

// ══════════════════════════════════════════════════════════
// FARMER ONBOARDING & MANAGEMENT MODULE
// ══════════════════════════════════════════════════════════

model Farmer {
  id               String         @id @default(cuid())
  // Auth
  mobile           String         @unique
  alternateMobile  String?
  email            String?
  password         String?
  otpHash          String?
  otpExpiry        DateTime?
  lastLoginAt      DateTime?
  // Personal
  fullName         String
  fatherName       String?
  dateOfBirth      DateTime?
  gender           Gender?
  aadhaarNumber    String?        @unique
  panNumber        String?
  photoUrl         String?
  // Address
  village          String?
  taluka           String?
  district         String?
  state            String?
  pincode          String?
  // Bank
  bankAccountName  String?
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  cancelledChequeUrl String?
  // Extended fields for Land Owner Registration
  farmerIdGenerated String?        @unique   // JGL-MH-NAS-F-001
  gisId             String?        @unique   // auto-generated GIS ID
  occupation        String?                  // Farmer / Landowner / Both / Other
  farmingExperience String?                  // years
  isFarmer          Boolean?       @default(false)
  // Nominee
  nomineeName       String?
  nomineeRelation   String?
  nomineeDob        DateTime?
  nomineeMobile     String?
  nomineeAddress    String?
  nomineeAadhaar    String?
  // Draft / progress tracking
  registrationStep  Int            @default(1)
  draftData         Json?                    // autosave draft
  // Status
  status           FarmerStatus   @default(REGISTERED)
  carbonConsent    Boolean        @default(false)
  // Relations
  assignedOfficerId String?
  assignedOfficer  FieldOfficer?  @relation(fields: [assignedOfficerId], references: [id])
  lands            Land[]
  documents        FarmerDocument[]
  plantations      Plantation[]
  landAssignments  LandAssignment[]
  payments         FarmerPayment[]
  inspections      SiteInspection[]
  auditLogs        AuditLog[]
  carbonCredits    CarbonCredit[]
  agreements       FarmerAgreement[]
  // Ownership tracking
  createdById      String?
  updatedById      String?
  approvedById     String?
  assignedAdminId  String?
  // Soft delete
  deletedAt        DateTime?
  deletedById      String?
  deleteReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("farmers")
}

model FieldOfficer {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  mobile       String       @unique
  password     String
  employeeId   String?      @unique
  designation  String?
  district     String?
  state        String?
  active       Boolean      @default(true)
  farmers      Farmer[]
  inspections  SiteInspection[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("field_officers")
}

model Land {
  id               String        @id @default(cuid())
  farmerId         String
  farmer           Farmer        @relation(fields: [farmerId], references: [id])
  // Survey details
  surveyGutNumber  String?              // combined Survey/Gut number
  surveyNumber     String?              // kept for backward compat
  gutNumber        String?              // kept for backward compat
  khataNumber      String?
  areaAcres        Float?
  areaHectares     Float?
  areaOfferedAcres Float?               // area proposed for project
  areaOfferedUnit  String?              // acres or hectares
  landType         LandType?
  // Location
  gpsLatitude      Float?
  gpsLongitude     Float?
  polygonGeoJson   Json?         // GeoJSON polygon boundary
  village          String?
  taluka           String?
  district         String?
  state            String?
  pincode          String?
  // Land Ownership
  waterAvailability String?              // RAIN_FED | IRRIGATED | BOREWELL | CANAL | OTHER
  securityStatus   String?              // FENCED | PARTIALLY_FENCED | UNFENCED | WALL | OTHER
  ownershipType    String?              // sole / joint
  jointOwnerCount  Int?
  nocUploaded      Boolean       @default(false)
  // Status
  verified         Boolean       @default(false)
  verifiedAt       DateTime?
  verifiedById     String?
  // Plantation
  plantationPreference  PlantationType?
  speciesPreference     String[]
  targetTreeCount  Int?
  plantationStartDate DateTime?
  // Relations
  documents        FarmerDocument[]
  plantations      Plantation[]
  landAssignments  LandAssignment[]
  inspections      SiteInspection[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("lands")
}

model FarmerDocument {
  id           String       @id @default(cuid())
  farmerId     String
  farmer       Farmer       @relation(fields: [farmerId], references: [id])
  landId       String?
  land         Land?        @relation(fields: [landId], references: [id])
  docType      DocumentType
  fileUrl      String
  fileName     String?
  fileSize     Int?
  mimeType     String?
  status       DocStatus    @default(PENDING)
  rejectionReason String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@map("farmer_documents")
}

model SiteInspection {
  id              String           @id @default(cuid())
  farmerId        String
  farmer          Farmer           @relation(fields: [farmerId], references: [id])
  landId          String?
  land            Land?            @relation(fields: [landId], references: [id])
  officerId       String
  officer         FieldOfficer     @relation(fields: [officerId], references: [id])
  scheduledDate   DateTime?
  inspectedAt     DateTime?
  gpsLatitude     Float?
  gpsLongitude    Float?
  // Checklist
  ownershipVerified  Boolean       @default(false)
  boundaryVerified   Boolean       @default(false)
  farmerMetPersonally Boolean      @default(false)
  plantationFeasible Boolean       @default(false)
  waterSourceAvailable Boolean     @default(false)
  // Report
  notes           String?
  reportPdfUrl    String?
  photos          String[]
  status          InspectionStatus @default(SCHEDULED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("site_inspections")
}

model Plantation {
  id              String          @id @default(cuid())
  farmerId        String
  farmer          Farmer          @relation(fields: [farmerId], references: [id])
  landId          String?
  land            Land?           @relation(fields: [landId], references: [id])
  projectName     String?
  plantationType  PlantationType?
  species         String[]
  treesPlanted    Int             @default(0)
  treesSurviving  Int             @default(0)
  plantedDate     DateTime?
  lastMonitored   DateTime?
  survivalRate    Float?
  gpsCoordinates  Json?
  photos          String[]
  notes           String?
  status          PlantationStatus @default(PLANNED)
  // Carbon
  co2Estimated    Float?          // tonnes
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("plantations")
}

model FarmerPayment {
  id            String        @id @default(cuid())
  farmerId      String
  farmer        Farmer        @relation(fields: [farmerId], references: [id])
  paymentType   PaymentType
  amount        Float
  description   String?
  status        PaymentStatus @default(PENDING)
  utrNumber     String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@map("farmer_payments")
}

model CarbonCredit {
  id              String       @id @default(cuid())
  farmerId        String
  farmer          Farmer       @relation(fields: [farmerId], references: [id])
  vintageYear     Int?
  creditsIssued   Float?       // tCO2e
  creditsSold     Float?
  revenueShared   Float?
  registry        String?      // Verra, Gold Standard etc
  serialNumber    String?
  status          CreditStatus @default(PENDING)
  issuedAt        DateTime?
  createdAt       DateTime     @default(now())

  @@map("carbon_credits")
}

model AuditLog {
  id          String    @id @default(cuid())
  farmerId    String?
  farmer      Farmer?   @relation(fields: [farmerId], references: [id])
  actorId     String?
  actorRole   String?
  action      String
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

// ── Enums ─────────────────────────────────────────────────


model FarmerAgreement {
  id              String   @id @default(cuid())
  farmerId        String
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  agreementType   String   // PARTICIPATION_AGREEMENT | PLANTATION_CERTIFICATE | SAPLING_RECEIPT | PAYMENT_RECEIPT | NOC
  title           String
  generatedHtml   String?  @db.Text  // admin-generated HTML content
  generatedPdfUrl String?  // URL of generated PDF
  signedPdfUrl    String?  // URL uploaded by farmer after signing
  status          String   @default("GENERATED") // GENERATED | SHARED | ACKNOWLEDGED | SIGNED | COMPLETED
  acknowledgedAt  DateTime?
  signedAt        DateTime?
  generatedById   String?
  sharedAt        DateTime?
  templateData    Json?    // data used to fill template
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("farmer_agreements")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FarmerStatus {
  REGISTERED
  DOCUMENTS_PENDING
  DOCUMENTS_VERIFIED
  INSPECTION_PENDING
  INSPECTION_COMPLETED
  APPROVED
  ACTIVE
  SUSPENDED
}

enum LandType {
  AGRICULTURAL
  PRIVATE
  WASTELAND
  AGROFORESTRY
  ORCHARD
  COMMUNITY
}

enum PlantationType {
  AGROFORESTRY
  MIYAWAKI
  NATIVE_FOREST
  FRUIT_TREES
  BAMBOO
  MIXED_SPECIES
}

enum DocumentType {
  AADHAAR
  PAN
  LAND_7_12
  LAND_RECORD
  PROPERTY_TAX
  OWNERSHIP_PROOF
  CONSENT_LETTER
  CANCELLED_CHEQUE
  PLANTATION_PHOTO
  JOINT_OWNER_NOC
  PARTICIPATION_AGREEMENT
  PLANTATION_CERTIFICATE
  SAPLING_RECEIPT
  PAYMENT_RECEIPT
  SIGNED_AGREEMENT
  SIGNED_NOC
  OTHER
}

enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlantationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MONITORING
  COMPLETED_VERIFIED
}

enum PaymentType {
  PLANTATION_INCENTIVE
  MAINTENANCE_INCENTIVE
  CARBON_REVENUE
  CSR_PAYMENT
}

enum CreditStatus {
  PENDING
  ISSUED
  SOLD
  RETIRED
}
