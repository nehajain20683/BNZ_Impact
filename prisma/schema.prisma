// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations (db push / migrate) need a DIRECT connection — Supabase's
  // Transaction Pooler (port 6543, used for DATABASE_URL at runtime) does
  // not reliably support the operations Prisma's migration engine needs,
  // and commonly just hangs. directUrl should point at the non-pooled
  // connection (port 5432) from Supabase → Settings → Database → Connection string.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  orgId   String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  mobile         String?
  address        String?
  pan            String?
  password       String?
  role           Role      @default(DONOR)
  image          String?
  // Extended fields
  isActive       Boolean   @default(true)
  isLocked       Boolean   @default(false)
  lastLoginAt    DateTime?
  loginAttempts  Int       @default(0)
  // Password reset
  resetOtpHash   String?
  resetOtpExpiry DateTime?
  // Soft delete
  deletedAt      DateTime?
  deletedById    String?
  deleteReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donations  Donation[]
  accounts   Account[]
  sessions   Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// A real, admin-uploaded representative photo per plant species — shown on
// a donor's Tree Story page. Deliberately not a hardcoded set of external
// stock-photo URLs: those can break, may not accurately represent what an
// org is actually planting, and carry licensing ambiguity. This lets each
// org set (and correct) their own image per species, once, reused
// everywhere that species appears.
model SpeciesImage {
  id        String   @id @default(cuid())
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id])
  species   String   // matches Tree.species / LandAssignment.speciesPlanted[].species, case-insensitive
  imageUrl  String
  // MAIN (primary/economic species, e.g. Mango) or SIDE (support/boundary
  // species, e.g. Bamboo) — drives the auto-allocation ratio when linking
  // sponsored trees. Null/uncategorized is treated as SIDE by default.
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, species])
  @@map("species_images")
}

model Campaign {
  orgId   String?
  organization Organization? @relation(fields: [orgId], references: [id])
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  treePrice   Float    @default(500)
  active      Boolean  @default(true)
  imageUrl    String?
  // Additional gallery photos beyond the single primary imageUrl — shown
  // as thumbnails on the campaign detail page. Same base64-upload pattern
  // used for Land.photos elsewhere in this app.
  galleryImages String[] @default([])
  goal        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // "What you get" perks shown on the campaign detail page — admin-editable
  // per campaign so an org can turn off a perk it doesn't actually offer
  // (e.g. e-greeting cards) rather than the page silently claiming a
  // feature that isn't real. Each item: { key, title, description, enabled }
  perks Json?

  // Display/branding — previously hardcoded per-campaign in src/lib/utils.ts,
  // now editable per tenant via Admin → Campaigns.
  subtitle       String?  // e.g. "In Honour of Your Grandmother"
  shortName      String?  // e.g. "Dadi" — used in compact UI and dedication labels
  dedicationLabel String? // e.g. "Grandmother" — used to build "Dedicated to my {label}"
  accentColor    String?  @default("#2d5a1b")
  accentBg       String?  @default("#f6faf3")
  accentBorder   String?  @default("#c9dcc0")
  displayOrder   Int      @default(0)

  // Sponsorship package tiers for this campaign — previously one hardcoded
  // global set (CAMPAIGN_PACKAGES) shared by every campaign/tenant.
  // Each item: { id, trees, badge, badgeEn, emoji, popular, description }
  packages Json?

  // The permanent "no specific campaign" bucket every org gets automatically
  // — donors picking "Individual" at /donate always land here, never on a
  // real admin-created campaign. Excluded from every public campaign list/
  // selector (homepage, /campaigns, the donate page's campaign picker).
  isIndividual Boolean @default(false)

  donations Donation[]

  @@map("campaigns")
}

model Donation {
  orgId   String?
  organization Organization? @relation(fields: [orgId], references: [id])
  id               String          @id @default(cuid())
  userId           String?
  campaignId       String
  amount           Float
  numberOfTrees    Int
  donorName        String
  certificateName  String?         // name to appear on certificate (can differ from donor)
  donorEmail       String
  donorMobile      String?
  donorAddress     String?
  donorPan         String?
  donorChapter     String?
  dedicationName   String?
  dedicationType   DedicationType?
  paymentStatus    PaymentStatus   @default(PENDING)
  paymentGatewayId String?
  paymentOrderId   String?
  paymentMethod    String?
  receiptNumber    String?         @unique
  certificateUrl   String?
  receiptUrl       String?
  // Manual entry fields
  paymentMode      String?         @default("ONLINE") // ONLINE | CASH | BANK_TRANSFER | CHEQUE | UPI
  paymentBank      String?         // for BANK_TRANSFER (e.g. Bank of Ghatkopar)
  paymentBranch    String?         // branch name
  chequeNumber     String?
  waMessageSent    Boolean         @default(false)
  waMessageSentAt  DateTime?
  certificateSent  Boolean         @default(false)
  certificateSentAt DateTime?
  form80GSent      Boolean         @default(false)
  notes            String?
  refId            String?         @unique // auto-generated ref like #BNZ-00001
  createdById      String?         // admin who manually added
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user        User?       @relation(fields: [userId], references: [id])
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  trees       Tree[]
  receipt     Receipt?
  certificate Certificate?

  @@map("donations")
}

model Tree {
  id          String     @id @default(cuid())
  donationId  String
  treeTagId   String?    @unique
  species     String?
  geoLatitude Float?
  geoLongitude Float?
  plantedDate DateTime?
  imageUrl    String?
  status      TreeStatus @default(PENDING)
  expectedCO2 Float?
  siteId      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  donation       Donation        @relation(fields: [donationId], references: [id])
  plantationSite PlantationSite? @relation(fields: [siteId], references: [id])
  monitoringSamples MonitoringTreeSample[]
  fieldIssues    FieldIssue[]
  assignmentId   String?
  assignment     LandAssignment? @relation(fields: [assignmentId], references: [id])
  images         TreeImage[]

  // Replacement tagging — when a tree dies, a new Tree row is created
  // rather than recycling this one, so the dead tree's own history (photos,
  // monitoring samples, cause of death) stays intact and queryable on its
  // own record instead of being overwritten. The new tree carries the same
  // donationId/assignmentId (the original donor's sponsorship continues
  // onto the replacement, not a separate one), just a fresh tag and status.
  replacesTreeId String? @unique
  replacesTree   Tree?   @relation("TreeReplacement", fields: [replacesTreeId], references: [id])
  replacedBy     Tree?   @relation("TreeReplacement")

  @@map("trees")
}

// Field Officer photo captures of a specific planted tree — the actual
// evidence photo, distinct from Tree.imageUrl (unused/legacy) and from
// SpeciesImage (a generic representative stock photo, not this specific
// tree). Deliberately allows many photos per tree over time — a tree
// photographed at planting, then again months later, should keep both,
// not overwrite. Storage uses the same base64-in-column approach already
// used everywhere else in this app (org logos, land photos, monitoring
// photos) — this app has no object storage (S3/R2/Supabase Storage)
// integration at all yet, so this matches the existing, proven pattern
// rather than introducing new infrastructure. storageKey is reserved for
// a future migration to real object storage without a breaking schema
// change later.
model TreeImage {
  id           String   @id @default(cuid())
  treeId       String
  tree         Tree     @relation(fields: [treeId], references: [id])
  treeTag      String?  // denormalized copy of Tree.treeTagId at capture time, for fast lookup/display
  imageUrl     String   @db.Text // base64 data URL
  fileName     String   // server-generated: {TreeTag}_{YYYYMMDD_HHMMSS}.jpg — never trusts a client-supplied name
  capturedById String
  capturedBy   FieldOfficer @relation(fields: [capturedById], references: [id])
  capturedAt   DateTime @default(now()) // server timestamp — source of truth, not client-supplied
  latitude     Float?
  longitude    Float?
  gpsAccuracy  Float?
  storageKey   String?  // reserved for a future real-object-storage migration
  tenantId     String   // orgId — every image is tenant-scoped, never visible cross-tenant
  createdAt    DateTime @default(now())

  @@index([treeId])
  @@index([treeTag])
  @@index([tenantId])
  @@map("tree_images")
}

// ─── MASTER PROJECT ──────────────────────────────────────────────────────────
model MasterProject {
  orgId   String?
  organization Organization? @relation(fields: [orgId], references: [id])
  id          String   @id @default(cuid())
  name        String                          // e.g. "Green Legacy Master Project"
  code        String?  @unique
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites PlantationSite[]

  @@map("master_projects")
}

// ─── IMPACT METRICS (generic, admin-defined) ─────────────────────────────────
// Lets Admin define impact metrics beyond CO2 (e.g. groundwater recharged,
// jobs created, biodiversity index) without a schema change per metric.
// A metric with zero recorded values simply never appears on the donor side.
model ImpactMetricDefinition {
  id              String   @id @default(cuid())
  orgId           String?
  organization    Organization? @relation(fields: [orgId], references: [id])
  name            String   // e.g. "Groundwater Recharged"
  unit            String   // e.g. "litres/year"
  icon            String?  @default("🌿") // emoji or short label
  color           String?  @default("#2d5a1b")
  description     String?
  // PER_TREE: value is a flat per-tree rate, multiply by tree count (like CO2).
  // SITE_PROPORTIONAL: value is recorded at the site level; a donor's share
  // is computed proportionally (their trees / site's total trees).
  calculationType String   @default("SITE_PROPORTIONAL")
  active          Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  values ImpactMetricValue[]

  @@map("impact_metric_definitions")
}

model ImpactMetricValue {
  id          String   @id @default(cuid())
  metricId    String
  metric      ImpactMetricDefinition @relation(fields: [metricId], references: [id])
  siteId      String
  site        PlantationSite @relation(fields: [siteId], references: [id])
  value       Float
  period      String?  // e.g. "2026" or "Q1 2026" — optional, for time-series metrics
  recordedAt  DateTime @default(now())
  notes       String?

  @@map("impact_metric_values")
}

// ─── PLANTATION SITE (enhanced) ──────────────────────────────────────────────
model PlantationSite {
  id                String   @id @default(cuid())
  projectId         String?
  project           MasterProject? @relation(fields: [projectId], references: [id])
  // Identity
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  siteName          String
  siteCode          String?  @unique
  internalRef       String?
  description       String?
  // Location
  state             String?
  district          String?
  taluka            String?
  village           String?
  gpsLatitude       Float?
  gpsLongitude      Float?
  geoData           Json?    // GeoJSON polygon
  // Area
  totalPlannedArea  Float?   // acres
  // Phase
  currentPhase      String   @default("PLANNING")
  // Team
  plantationPartner String?
  implementingAgency String?
  fieldOfficerId    String?
  supervisorId      String?
  carbonConsultant  String?
  auditor           String?
  nursery           String?
  // Dates
  plantationSeason  String?
  startDate         DateTime?
  endDate           DateTime?
  // Targets
  totalFarmers      Int?
  plannedArea       Float?
  plannedTrees      Int?
  estimatedCarbon   Float?
  estimatedCredits  Float?
  expectedSurvival  Float?
  budget            Float?
  // Actuals
  treesPlanted      Int      @default(0)
  treesSurviving    Int      @default(0)
  survivalRate      Float?
  // Status
  active            Boolean  @default(true)
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trees             Tree[]
  landAssignments   LandAssignment[]
  activities        PlantationActivity[]
  monitoringVisits  MonitoringVisit[]
  fieldIssues       FieldIssue[]
  carbonMonitoring  CarbonMonitoring[]
  siteDocuments     SiteDocument[]
  timelineEvents    TimelineEvent[]
  speciesPlans      SpeciesPlan[]
  notifications     SiteNotification[]
  impactMetricValues ImpactMetricValue[]

  @@map("plantation_sites")
}

// ─── SPECIES PLAN ─────────────────────────────────────────────────────────────
model SpeciesPlan {
  id              String   @id @default(cuid())
  siteId          String
  site            PlantationSite @relation(fields: [siteId], references: [id])
  species         String
  plannedQty      Int
  nurserySource   String?
  expectedSurvival Float?
  carbonFactor    Float?
  remarks         String?
  createdAt       DateTime @default(now())

  @@map("species_plans")
}

// ─── LAND ASSIGNMENT (Farmer Land → Plantation Site) ─────────────────────────
model LandAssignment {
  id              String   @id @default(cuid())
  siteId          String
  site            PlantationSite @relation(fields: [siteId], references: [id])
  farmerId        String
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  landId          String?
  land            Land?    @relation(fields: [landId], references: [id])
  // Assignment details
  treesAssigned   Int
  speciesAlloc    Json?    // [{species, qty}]
  plantationDate  DateTime?
  remarks         String?
  // Lifecycle stage
  stage           String   @default("ASSIGNED")
  // Actuals
  treesPlanted    Int      @default(0)
  treesSurviving  Int      @default(0)
  lastMonitored   DateTime?
  speciesPlanted  Json?    // [{species, qty, date}] cumulative
  driveLinks      String[] // Google Drive photo links
  // Flags
  consentSigned   Boolean  @default(false)
  consentDate     DateTime?
  assignedById    String?
  assignedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stageHistory    LandStageHistory[]
  monitoring      MonitoringVisit[]
  communityUpdates CommunityUpdate[]
  trees           Tree[]

  @@unique([siteId, landId])
  @@map("land_assignments")
}

// ─── LAND STAGE HISTORY ───────────────────────────────────────────────────────
model LandStageHistory {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   LandAssignment @relation(fields: [assignmentId], references: [id])
  stage        String
  date         DateTime @default(now())
  updatedById  String?
  photos       String[]
  remarks      String?

  @@map("land_stage_history")
}

// ─── COMMUNITY UPDATE ─────────────────────────────────────────────────────────
// Farmer-submitted photo/notes updates about their plantation — separate from
// official Field Officer monitoring (MonitoringVisit). Not donor-visible until
// an admin approves it. Mirrors the FarmerDocument approve/reject pattern.
model CommunityUpdate {
  id           String   @id @default(cuid())
  farmerId     String
  farmer       Farmer   @relation(fields: [farmerId], references: [id])
  assignmentId String?
  assignment   LandAssignment? @relation(fields: [assignmentId], references: [id])
  landId       String?
  land         Land?    @relation(fields: [landId], references: [id])

  category     String   // WATERING | WEEDING | FERTILIZER | PEST | DAMAGE | GENERAL
  photoUrl     String
  notes        String?

  // Auto-captured at submission time
  gpsLatitude  Float?
  gpsLongitude Float?
  deviceInfo   String?
  submittedAt  DateTime @default(now())

  // Review pipeline (Phase 6/7 will extend this)
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | NEEDS_REVIEW
  reviewNotes    String?
  reviewedById   String?
  reviewedAt     DateTime?

  @@map("community_updates")
}

// ─── PLANTATION ACTIVITY ──────────────────────────────────────────────────────
model PlantationActivity {
  id           String   @id @default(cuid())
  siteId       String
  site         PlantationSite @relation(fields: [siteId], references: [id])
  date         DateTime
  activityType String   // PIT_DIGGING | SAPLING_DELIVERY | PLANTATION | IRRIGATION | FERTILIZER | WEEDING | GAP_FILLING | MONITORING | SURVIVAL_SURVEY | ISSUE
  description  String?
  team         String?
  workers      Int?
  treesPlanted   Int?
  speciesPlanted Json?    // [{species, qty}]
  driveLink      String?  // Google Drive / Photos link
  photos         String[]
  documents      String[]
  remarks        String?
  loggedById     String?
  createdAt      DateTime @default(now())

  @@map("plantation_activities")
}

// ─── MONITORING VISIT ─────────────────────────────────────────────────────────
model MonitoringVisit {
  id             String   @id @default(cuid())
  siteId         String
  site           PlantationSite @relation(fields: [siteId], references: [id])
  assignmentId   String?
  assignment     LandAssignment? @relation(fields: [assignmentId], references: [id])
  visitDate      DateTime
  officerId      String?
  farmerId       String?
  survivalCount  Int?
  deadTrees      Int?
  diseaseNotes   String?
  avgHeight      Float?   // cm
  photos         String[]
  gpsLat         Float?
  gpsLng         Float?
  recommendations String?
  driveLink      String?  // Google Drive/Photos folder link for this visit's photos/videos
  survivalPct    Float?
  mortalityPct   Float?
  // Publishing gate — Phase 7/8. A visit only becomes donor-visible once an
  // admin explicitly publishes it; raw field data never reaches donors directly.
  status         String   @default("SUBMITTED") // SUBMITTED | VERIFIED | PUBLISHED | SENT_BACK
  donorVisible   Boolean  @default(false)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime @default(now())

  treeSamples    MonitoringTreeSample[]

  @@map("monitoring_visits")
}

// Per-tree sampling records for a monitoring visit — a visit does not need
// to record every tree, only a representative sample.
model MonitoringTreeSample {
  id         String   @id @default(cuid())
  visitId    String
  visit      MonitoringVisit @relation(fields: [visitId], references: [id])
  treeId     String?  // optional link to a real Tree row, if one exists
  tree       Tree?    @relation(fields: [treeId], references: [id])
  species    String?
  height     Float?   // cm
  diameter   Float?   // cm
  health     String?  // HEALTHY | STRESSED | DISEASED | DEAD
  survived   Boolean  @default(true)
  photo      String?
  gpsLat     Float?
  gpsLng     Float?
  notes      String?
  createdAt  DateTime @default(now())

  @@map("monitoring_tree_samples")
}

// ─── CARBON MONITORING ────────────────────────────────────────────────────────
model CarbonMonitoring {
  id              String   @id @default(cuid())
  siteId          String
  site            PlantationSite @relation(fields: [siteId], references: [id])
  methodology     String?  // Verra VM0047 | Gold Standard | etc.
  creditingPeriod Int?     // years
  vintage         String?
  monitoringPeriod String?
  baseline        Float?
  additionality   Float?
  leakage         Float?
  bufferPool      Float?
  registryStatus  String   @default("DRAFT")
  registryLink    String?
  totalCredits    Float?
  issuedCredits   Float?
  pendingCredits  Float?
  notes           String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("carbon_monitoring")
}

// ─── TIMELINE EVENT ───────────────────────────────────────────────────────────
model TimelineEvent {
  id          String   @id @default(cuid())
  // Optional — a small number of historical events can outlive the site
  // they were logged against (e.g. the site was later deleted). Keeping the
  // event with siteId cleared preserves that history instead of losing it.
  siteId      String?
  site        PlantationSite? @relation(fields: [siteId], references: [id])
  eventType   String
  title       String
  description String?
  eventDate   DateTime @default(now())
  attachments String[]
  createdById String?
  createdAt   DateTime @default(now())

  @@map("timeline_events")
}

// ─── SITE DOCUMENT ────────────────────────────────────────────────────────────
model SiteDocument {
  id          String   @id @default(cuid())
  siteId      String
  site        PlantationSite @relation(fields: [siteId], references: [id])
  folder      String   // PLANTATION_PLAN | FARMER_CONSENTS | GPS_MAPS | etc.
  fileName    String
  fileUrl     String
  fileSize    Int?
  version     Int      @default(1)
  uploadedById String?
  uploadedAt  DateTime @default(now())

  @@map("site_documents")
}

// ─── SITE NOTIFICATION ────────────────────────────────────────────────────────
model SiteNotification {
  id        String   @id @default(cuid())
  siteId    String
  site      PlantationSite @relation(fields: [siteId], references: [id])
  type      String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("site_notifications")
}

// ─── NOTIFICATIONS (per-recipient) ───────────────────────────────────────────
// SiteNotification above is a site-wide broadcast, not tied to a specific
// person — doesn't fit "this farmer needs to see this." This is the
// recipient-specific counterpart used by Phase 10.
model Notification {
  id            String   @id @default(cuid())
  // FARMER + Farmer.id | FIELD_OFFICER + FieldOfficer.id | ADMIN_ORG + Organization.id (all admins of that org)
  recipientType String
  recipientId   String
  type          String   // PLANTATION_ASSIGNED | MONITORING_SCHEDULED | UPDATE_APPROVED | UPDATE_REJECTED | ACTIVITY_REMINDER | MONITORING_DUE | PENDING_REVIEW
  title         String
  message       String?
  link          String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([recipientType, recipientId, read])
  @@map("notifications")
}


model Receipt {
  id            String   @id @default(cuid())
  donationId    String   @unique
  receiptPdfUrl String?
  generatedAt   DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id])

  @@map("receipts")
}

model Certificate {
  id                String   @id @default(cuid())
  donationId        String   @unique
  certificatePdfUrl String?
  generatedAt       DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id])

  @@map("certificates")
}


model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  primary_color       String?  @default("#2d5a1b")
  logo_url            String?
  email               String?
  phone               String?
  address             String?
  website             String?
  farmer_id_prefix    String?  @default("BNZ")
  donation_ref_prefix String?  @default("BNZ")
  tree_price          Int?     @default(500)
  org_80g_number      String?
  campaign_config     Json?
  payment_banks       Json?
  custom_domain       String?  @unique
  plan                String?  @default("STARTER")
  active              Boolean  @default(true)
  created_at          DateTime @default(now())

  // Tenant-editable legal content — set via Super Admin. When null, the
  // public legal pages show a generic placeholder instead of assuming any
  // other tenant's specific legal/jurisdiction facts (see BRANDING_ANALYSIS.md).
  privacy_policy_text String?  @db.Text
  terms_text          String?  @db.Text
  refund_policy_text  String?  @db.Text

  // Per-tenant Razorpay credentials — set via Super Admin only, never exposed
  // to Tenant Admins. When null, payment flows fall back to the platform's
  // own RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET env vars (see src/lib/razorpay.ts).
  // NOTE: stored as plain text for now, matching the rest of this table —
  // for real production use this should move to an encrypted column or a
  // secrets manager before onboarding tenants with real payment credentials.
  razorpay_key_id     String?
  razorpay_key_secret String?
  payment_display_name    String?
  payment_success_message String?
  razorpay_webhook_secret String?

  // Shown on the certificate/receipt for "Individual" donations — the ones
  // deliberately not tied to any specific campaign. When null, a generic
  // fallback message is used instead.
  individual_donation_message String? @db.Text

  // Target % of a donor's linked trees that should be Main-category species
  // (e.g. Mango) vs Side-category (e.g. Bamboo) when using "Auto-allocate
  // by category ratio" in Link Sponsored Trees. Configurable per org since
  // different programs may target a different split.
  main_tree_target_percent Int @default(80)
  // Radius (meters) within which a field officer's GPS must fall for a
  // farm check-in to count as geofence-verified. 200m default — generous
  // enough to absorb ordinary rural GPS drift without being so wide it
  // stops meaning anything. Officers can still proceed if outside this,
  // but it's explicitly recorded as an override, visible to admin.
  geofence_radius_meters Int @default(200)


  users            User[]
  campaigns        Campaign[]
  donations        Donation[]
  farmers          Farmer[]
  lands            Land[]
  plantationSites  PlantationSite[]
  masterProjects   MasterProject[]
  speciesImages    SpeciesImage[]
  fieldOfficers    FieldOfficer[]
  signatories      OrgSignatory[]
  impactMetricDefinitions ImpactMetricDefinition[]

  @@map("organizations")
}

enum Role {
  DONOR
  ADMIN
  SUPER_ADMIN
  FIELD_OFFICER
  DATA_ENTRY
  PROJECT_MANAGER
  AUDITOR
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DedicationType {
  MOTHER
  FATHER
  GRANDPARENTS
  DAUGHTER
  MEMORIAL
  CSR
  OTHER
}

enum TreeStatus {
  PENDING
  PLANTED
  GROWING
  MATURE
  DEAD
}

// ══════════════════════════════════════════════════════════
// FARMER ONBOARDING & MANAGEMENT MODULE
// ══════════════════════════════════════════════════════════

model Farmer {
  id               String         @id @default(cuid())
  // Auth
  mobile           String         @unique
  alternateMobile  String?
  email            String?
  password         String?
  otpHash          String?
  otpExpiry        DateTime?
  lastLoginAt      DateTime?
  // Personal
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  fullName         String
  photo            String?        @db.Text // farmer's own photo, base64 — same storage pattern as everything else in this app
  // Opt-in only, defaults false — a verified farmer is NOT shown on public
  // pages (Meet the Farmers, site story) until an admin explicitly enables
  // this, deliberately the safer default rather than showing everyone's
  // name/village/photo publicly by default just because they're verified.
  publiclyVisible  Boolean        @default(false)
  fatherName       String?
  dateOfBirth      DateTime?
  gender           Gender?
  aadhaarNumber    String?        @unique
  panNumber        String?
  photoUrl         String?
  // Address
  village          String?
  taluka           String?
  district         String?
  state            String?
  pincode          String?
  // Bank
  bankAccountName  String?
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  cancelledChequeUrl String?
  // Extended fields for Land Owner Registration
  farmerIdGenerated String?        @unique   // JGL-MH-NAS-F-001
  gisId             String?        @unique   // auto-generated GIS ID
  occupation        String?                  // Farmer / Landowner / Both / Other
  farmingExperience String?                  // years
  isFarmer          Boolean?       @default(false)
  // Nominee
  nomineeName       String?
  nomineeRelation   String?
  nomineeDob        DateTime?
  nomineeMobile     String?
  nomineeAddress    String?
  nomineeAadhaar    String?
  // Draft / progress tracking
  registrationStep  Int            @default(1)
  draftData         Json?                    // autosave draft
  // Status
  status           FarmerStatus   @default(REGISTERED)
  carbonConsent    Boolean        @default(false)
  // Relations
  assignedOfficerId String?
  assignedOfficer  FieldOfficer?  @relation(fields: [assignedOfficerId], references: [id])
  lands            Land[]
  documents        FarmerDocument[]
  plantations      Plantation[]
  landAssignments  LandAssignment[]
  payments         FarmerPayment[]
  inspections      SiteInspection[]
  fieldIssues      FieldIssue[]
  checkIns         FarmCheckIn[]
  auditLogs        AuditLog[]
  carbonCredits    CarbonCredit[]
  agreements       FarmerAgreement[]
  communityUpdates CommunityUpdate[]
  // Ownership tracking
  createdById      String?
  updatedById      String?
  approvedById     String?
  assignedAdminId  String?
  // Soft delete
  deletedAt        DateTime?
  deletedById      String?
  deleteReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("farmers")
}

model FieldOfficer {
  id           String       @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  name         String
  signatureImage String?    @db.Text // captured once on their own device (drawn or uploaded), reused on every document they'd otherwise sign in person — sapling receipts, plantation certificates, farmer payment receipts
  email        String       @unique
  mobile       String       @unique
  password     String
  employeeId   String?      @unique
  designation  String?
  district     String?
  state        String?
  active       Boolean      @default(true)
  lastLoginAt  DateTime?
  farmers      Farmer[]
  inspections  SiteInspection[]
  treeImages   TreeImage[]
  fieldIssues  FieldIssue[]
  checkIns     FarmCheckIn[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("field_officers")
}

// Authorized signatories for an org — the people whose signature stands in
// for "the organization" on generated documents (certificates, receipts,
// agreements). Super Admin manages these; document generation picks the
// one marked isPrimary for whichever slot currently just says "Authorised
// Signatory" / "Authorised By" / "Project Authority" with a blank line and
// nothing else. Kept as its own list (not a single field on Organization)
// since more than one person may legitimately sign different documents
// over time, and history matters — a document shouldn't silently change
// whose name appears on it if the signatory list is edited later.
model OrgSignatory {
  id             String   @id @default(cuid())
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id])
  name           String
  designation    String   // e.g. "Managing Trustee", "Program Director"
  signatureImage String   @db.Text
  isPrimary      Boolean  @default(false) // used by default wherever a document needs one signatory and doesn't ask which
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
  @@map("org_signatories")
}

model Land {
  id               String        @id @default(cuid())
  farmerId         String
  farmer           Farmer        @relation(fields: [farmerId], references: [id])
  // Tenant scoping — this column already exists in the live database (added
  // outside of this schema history); adding it here so `db push` reflects
  // reality instead of trying to drop it.
  orgId            String?
  organization     Organization? @relation(fields: [orgId], references: [id])
  // Survey details
  surveyGutNumber  String?              // combined Survey/Gut number
  khataNumber      String?
  areaAcres        Float?
  areaHectares     Float?
  areaOfferedAcres Float?               // area proposed for project
  areaOfferedUnit  String?              // acres or hectares
  landType         LandType?
  currentLandUse   String?              // what the land is used for today — fallow, cultivated, grazing, barren, etc. Distinct from landType, which is a registry classification.
  // Location
  gpsLatitude      Float?
  gpsLongitude     Float?
  // Real boundary geometry, extracted from an uploaded KML/KMZ file (a
  // FarmerDocument with docType OTHER) — a standard GeoJSON Polygon,
  // [[[lon, lat], [lon, lat], ...]]. Null until someone actually parses an
  // uploaded file into it; gpsLatitude/gpsLongitude above remain the single
  // point used everywhere else until this exists for a given parcel.
  polygonGeoJson   Json?
  kmlFileName      String?       // original filename of the uploaded KML/KMZ boundary file
  // Land + KML preview photos — the actual root cause of the repeated
  // "Invalid prisma.land.update()" errors. Both the create and edit routes
  // have always written to this field, but it was never declared here, so
  // the generated Prisma Client didn't know it existed. Same situation as
  // the orgId column below: matching reality, not introducing something new.
  photos           String[]
  village          String?
  taluka           String?
  district         String?
  state            String?
  pincode          String?
  // Land Ownership
  waterAvailability String?              // RAIN_FED | IRRIGATED | BOREWELL | CANAL | OTHER
  securityStatus   String?              // FENCED | PARTIALLY_FENCED | UNFENCED | WALL | OTHER
  ownershipType    String?              // sole / joint
  jointOwnerCount  Int?
  nocUploaded      Boolean       @default(false)
  // Status
  verified         Boolean       @default(false)
  verifiedAt       DateTime?
  verifiedById     String?
  // Full per-land approval pipeline — `verified`/`verifiedAt`/`verifiedById`
  // above are kept in sync for backward compatibility (true once status
  // reaches APPROVED or beyond), but `status` is now the source of truth.
  status           LandStatus    @default(DOCUMENTS_PENDING)
  // Plantation
  plantationPreference  PlantationType?
  plantationTypeOtherText String?       // free-text description when plantationPreference is OTHER
  speciesPreference     String[]
  targetTreeCount  Int?
  plantationStartDate DateTime?
  // Relations
  documents        FarmerDocument[]
  farmerAgreements FarmerAgreement[]
  plantations      Plantation[]
  landAssignments  LandAssignment[]
  inspections      SiteInspection[]
  communityUpdates CommunityUpdate[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("lands")
}

model FarmerDocument {
  id           String       @id @default(cuid())
  farmerId     String
  farmer       Farmer       @relation(fields: [farmerId], references: [id])
  landId       String?
  land         Land?        @relation(fields: [landId], references: [id])
  docType      DocumentType
  fileUrl      String
  fileName     String?
  fileSize     Int?
  mimeType     String?
  status       DocStatus    @default(PENDING)
  rejectionReason String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@map("farmer_documents")
}

model SiteInspection {
  id              String           @id @default(cuid())
  farmerId        String
  farmer          Farmer           @relation(fields: [farmerId], references: [id])
  landId          String?
  land            Land?            @relation(fields: [landId], references: [id])
  officerId       String
  officer         FieldOfficer     @relation(fields: [officerId], references: [id])
  scheduledDate   DateTime?
  inspectedAt     DateTime?
  gpsLatitude     Float?
  gpsLongitude    Float?
  // Checklist
  ownershipVerified  Boolean       @default(false)
  boundaryVerified   Boolean       @default(false)
  farmerMetPersonally Boolean      @default(false)
  plantationFeasible Boolean       @default(false)
  waterSourceAvailable Boolean     @default(false)
  // Report
  notes           String?
  reportPdfUrl    String?
  photos          String[]
  status          InspectionStatus @default(SCHEDULED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("site_inspections")
}

// A Field Officer's one-tap report of a real problem seen in the field —
// animal damage, flood, fire, pest attack, missing trees, wrong species
// planted. Deliberately separate from SiteInspection (a scheduled land
// verification) and MonitoringVisit (routine health checks) — an issue
// report is an unscheduled, urgent flag that needs admin attention, not a
// routine record.
model FieldIssue {
  id           String   @id @default(cuid())
  siteId       String
  site         PlantationSite @relation(fields: [siteId], references: [id])
  farmerId     String?
  farmer       Farmer?  @relation(fields: [farmerId], references: [id])
  treeId       String?  // optional — some issues (e.g. wrong species) point at one specific tree
  tree         Tree?    @relation(fields: [treeId], references: [id])
  reportedById String
  reportedBy   FieldOfficer @relation(fields: [reportedById], references: [id])
  issueType    String   // ANIMAL_DAMAGE | FLOOD | FIRE | PEST_ATTACK | MISSING_TREES | WRONG_SPECIES | OTHER
  severity     String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  description  String?  @db.Text
  photos       String[]
  gpsLat       Float?
  gpsLng       Float?
  status       String   @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  resolutionNotes String? @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId])
  @@index([farmerId])
  @@index([status])
  @@map("field_issues")
}

// One check-in per officer+farmer+day — the "Farm Visit" spec module's
// arrival step: GPS + arrival photo + distance from the farmer's
// registered land, gating the routine actions (Farm Visit inspection,
// Health Monitoring, Quick Visit) until it's done. Deliberately NOT a hard
// block when outside the geofence radius — the farmer's registered GPS can
// itself be imprecise, so an override is allowed but is explicitly
// recorded as such, giving admin full visibility into which check-ins were
// GPS-verified vs manually overridden, rather than silently blocking
// genuinely correct field work over bad reference data.
model FarmCheckIn {
  id             String   @id @default(cuid())
  farmerId       String
  farmer         Farmer   @relation(fields: [farmerId], references: [id])
  officerId      String
  officer        FieldOfficer @relation(fields: [officerId], references: [id])
  checkedInAt    DateTime @default(now())
  gpsLat         Float?
  gpsLng         Float?
  distanceMeters Int?     // distance from the farmer's registered land GPS, if both points are known
  withinGeofence Boolean  @default(false)
  overridden     Boolean  @default(false) // true if the officer proceeded despite being outside the geofence
  arrivalPhoto   String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([farmerId])
  @@index([officerId])
  @@map("farm_check_ins")
}

model Plantation {
  id              String          @id @default(cuid())
  farmerId        String
  farmer          Farmer          @relation(fields: [farmerId], references: [id])
  landId          String?
  land            Land?           @relation(fields: [landId], references: [id])
  projectName     String?
  plantationType  PlantationType?
  species         String[]
  treesPlanted    Int             @default(0)
  treesSurviving  Int             @default(0)
  plantedDate     DateTime?
  lastMonitored   DateTime?
  survivalRate    Float?
  gpsCoordinates  Json?
  photos          String[]
  notes           String?
  status          PlantationStatus @default(PLANNED)
  // Carbon
  co2Estimated    Float?          // tonnes
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("plantations")
}

model FarmerPayment {
  id            String        @id @default(cuid())
  farmerId      String
  farmer        Farmer        @relation(fields: [farmerId], references: [id])
  paymentType   PaymentType
  amount        Float
  description   String?
  status        PaymentStatus @default(PENDING)
  utrNumber     String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@map("farmer_payments")
}

model CarbonCredit {
  id              String       @id @default(cuid())
  farmerId        String
  farmer          Farmer       @relation(fields: [farmerId], references: [id])
  vintageYear     Int?
  creditsIssued   Float?       // tCO2e
  creditsSold     Float?
  revenueShared   Float?
  registry        String?      // Verra, Gold Standard etc
  serialNumber    String?
  status          CreditStatus @default(PENDING)
  issuedAt        DateTime?
  createdAt       DateTime     @default(now())

  @@map("carbon_credits")
}

model AuditLog {
  id          String    @id @default(cuid())
  farmerId    String?
  farmer      Farmer?   @relation(fields: [farmerId], references: [id])
  actorId     String?
  actorRole   String?
  action      String
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

// ── Enums ─────────────────────────────────────────────────


model FarmerAgreement {
  id              String   @id @default(cuid())
  farmerId        String
  farmer          Farmer   @relation(fields: [farmerId], references: [id])
  // Which specific land parcel this document describes — a farmer can
  // have several, and every one of these document types (participation
  // agreement, sapling receipt, plantation certificate...) describes one
  // particular parcel's details, not the farmer in the abstract.
  landId          String?
  land            Land?    @relation(fields: [landId], references: [id])
  agreementType   String   // PARTICIPATION_AGREEMENT | PLANTATION_CERTIFICATE | SAPLING_RECEIPT | PAYMENT_RECEIPT | NOC
  title           String
  generatedHtml   String?  @db.Text  // admin-generated HTML content
  generatedPdfUrl String?  // URL of generated PDF
  signedPdfUrl    String?  // URL uploaded by farmer after signing
  status          String   @default("GENERATED") // GENERATED | SHARED | ACKNOWLEDGED | SIGNED | COMPLETED
  acknowledgedAt  DateTime?
  signedAt        DateTime?
  generatedById   String?
  sharedAt        DateTime?
  templateData    Json?    // data used to fill template
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("farmer_agreements")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Simplified — a Farmer as a *person* only ever has these 4 stages. Every
// stage previously here that actually describes a specific piece of LAND
// (inspection, approval, activation) has moved to LandStatus below, since a
// farmer can own many lands, each independently at a different stage.
enum FarmerStatus {
  REGISTERED
  DOCUMENTS_PENDING   // only Aadhaar is required at the farmer-entity level
  VERIFIED_LAND_OWNER // personal + bank complete, Aadhaar verified — profile locks
  SUSPENDED
}

// Per-land approval pipeline — independent for every parcel a farmer owns.
enum LandStatus {
  DOCUMENTS_PENDING
  DOCUMENTS_VERIFIED
  INSPECTION_PENDING
  INSPECTION_COMPLETED
  APPROVED
  ACTIVE
}

enum LandType {
  AGRICULTURAL
  PRIVATE
  WASTELAND
  AGROFORESTRY
  ORCHARD
  COMMUNITY
}

enum PlantationType {
  AGROFORESTRY
  MIYAWAKI
  NATIVE_FOREST
  FRUIT_TREES
  BAMBOO
  MIXED_SPECIES
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  LAND_7_12
  LAND_RECORD
  PROPERTY_TAX
  OWNERSHIP_PROOF
  CONSENT_LETTER
  CANCELLED_CHEQUE
  PLANTATION_PHOTO
  JOINT_OWNER_NOC
  PARTICIPATION_AGREEMENT
  PLANTATION_CERTIFICATE
  SAPLING_RECEIPT
  PAYMENT_RECEIPT
  SIGNED_AGREEMENT
  SIGNED_NOC
  OTHER
}

enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlantationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MONITORING
  COMPLETED_VERIFIED
}

enum PaymentType {
  PLANTATION_INCENTIVE
  MAINTENANCE_INCENTIVE
  CARBON_REVENUE
  CSR_PAYMENT
}

enum CreditStatus {
  PENDING
  ISSUED
  SOLD
  RETIRED
}
