# ═══════════════════════════════════════════════════════════════
# BNZ Green Technologies — Multi-tenant SaaS Environment Variables
# Copy this file to .env.local for local development
# Each Vercel project gets its own set of these variables
# ═══════════════════════════════════════════════════════════════

# ── DATABASE ─────────────────────────────────────────────────
# Same Supabase DB for all tenants — orgId isolates data
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── AUTH ─────────────────────────────────────────────────────
# NEXTAUTH_SECRET: same value across all deployments (JWT is stateless)
NEXTAUTH_SECRET="your-secret-key-min-32-chars"

# NEXTAUTH_URL: MUST be unique per Vercel project
# JITO:        https://jito-green-legacy.vercel.app
# Rotary:      https://rotary.bnzgreen.io
# BNZ Green:   https://bnz.bnzgreen.io
# BNZ Admin:   https://admin.bnzgreen.io
# Localhost:   http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── TENANT IDENTIFICATION ────────────────────────────────────
# Set this per Vercel project to identify which tenant this deployment serves
# Must match the 'slug' column in the organizations table
# Leave blank for localhost (falls back to JITO)
#
# JITO deployment:    TENANT_SLUG=jito-mumbai
# Rotary deployment:  TENANT_SLUG=rotary-mumbai-north
# BNZ Green:          TENANT_SLUG=bnz-green
# BNZ Admin:          TENANT_SLUG=superadmin
TENANT_SLUG=""

# ── PAYMENTS (Razorpay) ──────────────────────────────────────
# Test keys — replace with live keys for production
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ── EMAIL (Resend) ───────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="onboarding@resend.dev"
FROM_NAME="Green Legacy"
