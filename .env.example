# ─── Database (REQUIRED) ──────────────────────────────────────────────────────
# Use Supabase TRANSACTION POOLER URL (port 6543) — works from any IP on Vercel
# Go to: Supabase → Settings → Database → Connection string → Transaction tab
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-a-random-32-char-string-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXX"

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_XXXXXXXXXX"
FROM_EMAIL="onboarding@resend.dev"
FROM_NAME="JITO Green Legacy"
